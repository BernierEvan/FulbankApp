<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryBlue" Color="#007AFF"/>
    <SolidColorBrush x:Key="PrimaryBlueDark" Color="#005BC4"/>
    <SolidColorBrush x:Key="PrimaryBlueLight" Color="#4DA3FF"/>
    <SolidColorBrush x:Key="AccentCyan" Color="#00E5FF"/>
    <SolidColorBrush x:Key="HighlightGlow" Color="#80DFFF"/>
    <SolidColorBrush x:Key="BackgroundDark" Color="#121212"/>
    <SolidColorBrush x:Key="BackgroundMedium" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="BackgroundLight" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="OverlayOpacity" Color="#AA121212"/>
    <SolidColorBrush x:Key="TextLight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextMedium" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="TextFaded" Color="#757575"/>
    <SolidColorBrush x:Key="StatusSuccess" Color="#4CAF50"/>
    <SolidColorBrush x:Key="StatusWarning" Color="#FFC107"/>
    <SolidColorBrush x:Key="StatusError" Color="#F44336"/>
    <SolidColorBrush x:Key="StatusInfo" Color="#2196F3"/>


    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryBlue}" Offset="0.0"/>
        <GradientStop Color="{StaticResource AccentCyan}" Offset="1.0"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="AccentRadial">
        <GradientStop Color="{StaticResource PrimaryBlueLight}" Offset="0"/>
        <GradientStop Color="{StaticResource BackgroundMedium}" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="CardEdgeGradient" StartPoint="0,0" EndPoint="0,1">

        <GradientStop Color="#4D4DA3FF" Offset="0.0"/>

        <GradientStop Color="#00007AFF" Offset="0.5"/>

        <GradientStop Color="#4D4DA3FF" Offset="1.0"/>

    </LinearGradientBrush>


</ResourceDictionary>