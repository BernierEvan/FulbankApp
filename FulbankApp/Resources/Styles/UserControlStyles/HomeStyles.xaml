<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    
    <!--#region Navbar-->
    
    <!-- Buttons -->
    <Style x:Key="NavButtonStyle" TargetType="Button">
        
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0,5,0,5"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,0,0,0"/>
        <Setter Property="FontSize" Value="14"/>
        
    </Style>
    
    <!--#endregion-->

    
    <!--#region Hover-->

    <Style x:Key="HoverButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Opacity" Value="1"/>
        <!-- ✅ visible par défaut -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ScalePart" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <Border x:Name="Bd"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="#66B0DFFF"
                            BorderThickness="2">
                            <Border.Background>

                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#AA2196F3" Offset="0.0"/>
                                    <GradientStop Color="#882196F3" Offset="1.0"/>
                                </LinearGradientBrush>

                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>
                        <!-- Ombre -->
                        <Border Background="Transparent" CornerRadius="12" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect x:Name="shadowEffect"
                                                  Color="Black"
                                                  BlurRadius="8"
                                                  ShadowDepth="4"
                                                  Opacity="0"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--#endregion-->
    
    
</ResourceDictionary>