<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    
    <!--#region Converters-->
    
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    
    <!--#endregion-->
    
    <!--#region Hover-->

    <Style x:Key="HoverButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Grille principale avec transformation pour l'effet de scale -->
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ScalePart" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <!-- Bordure du bouton avec gradient bleu -->
                        <Border x:Name="ButtonBorder"
                        CornerRadius="12"
                        Padding="{TemplateBinding Padding}"
                        BorderBrush="#66B0DFFF"
                        BorderThickness="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#AA2196F3" Offset="0.0"/>
                                    <GradientStop Color="#882196F3" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <!-- Contenu du bouton (texte, icône, etc.) -->
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>

                        <!-- Bordure transparente pour l'ombre portée -->
                        <Border Background="Transparent"
                        CornerRadius="12"
                        IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect x:Name="ShadowEffect"
                                        Color="Black"
                                        BlurRadius="8"
                                        ShadowDepth="4"
                                        Opacity="0"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#endregion-->
    
    <!--#region PinButtons-->

    <Style x:Key="RoundPinButton" TargetType="Button">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Ellipse pour la forme ronde -->
                        <Ellipse Fill="{TemplateBinding Background}"
                       Stroke="{TemplateBinding BorderBrush}"
                       StrokeThickness="{TemplateBinding BorderThickness}"/>

                        <!-- Contenu du bouton (chiffre ou symbole) -->
                        <ContentPresenter x:Name="ContentPresenter"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Effet de survol: légère transparence -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentPresenter" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <!-- Effet de pression: transparence plus forte -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ContentPresenter" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton PIN de validation (X) - fond rouge -->
    <Style x:Key="RoundPinValidButton" TargetType="Button" BasedOn="{StaticResource RoundPinButton}">
        <Setter Property="Background" Value="Red"/>
    </Style>

    <!-- Bouton PIN de retour (flèche) - fond orange -->
    <Style x:Key="RoundPinBackButton" TargetType="Button" BasedOn="{StaticResource RoundPinButton}">
        <Setter Property="Background" Value="DarkOrange"/>
    </Style>

    <!--#endregion-->

    <!--#region CharacterSelection-->

    <Style x:Key="SkinButton" TargetType="Button">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="150"/>
        <Setter Property="Background" Value="#22FFFFFF"/>
        <Setter Property="BorderBrush" Value="#66FFFFFF"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Bordure avec transformation pour l'effet de scale au survol -->
                    <Border x:Name="SkinBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="SkinScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>

                        <!-- Contenu du bouton (image du skin) -->
                        <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Animation au survol: bordure plus visible et légère augmentation de taille -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Éclaircir la bordure -->
                                        <ColorAnimation Storyboard.TargetName="SkinBorder"
                                              Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                              To="#AAFFFFFF"
                                              Duration="0:0:0.2"/>
                                        <!-- Augmenter légèrement la taille (105%) -->
                                        <DoubleAnimation Storyboard.TargetName="SkinScale"
                                               Storyboard.TargetProperty="ScaleX"
                                               To="1.05"
                                               Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="SkinScale"
                                               Storyboard.TargetProperty="ScaleY"
                                               To="1.05"
                                               Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <!-- Retour à la normale quand la souris quitte -->
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="SkinBorder"
                                              Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                              To="#66FFFFFF"
                                              Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="SkinScale"
                                               Storyboard.TargetProperty="ScaleX"
                                               To="1"
                                               Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="SkinScale"
                                               Storyboard.TargetProperty="ScaleY"
                                               To="1"
                                               Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#endregion-->
    
    
</ResourceDictionary>