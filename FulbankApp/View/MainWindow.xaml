<Window x:Class="FulbankApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FulbankApp"
        xmlns:vm="clr-namespace:FulbankApp.ViewModels"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        mc:Ignorable="d"
        Title="FulbankApp"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}"/>

        <Grid Panel.ZIndex="1000" 
      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Background="#CC000000"/>

            <Canvas ClipToBounds="True" Width="1920" Height="1080" 
            VerticalAlignment="Center" HorizontalAlignment="Center">

                <Image Source="/assets/images/seemless_loading_screen.png" 
               Width="1920" Height="1080" Stretch="UniformToFill"
               Canvas.Left="0" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <TranslateTransform X="0"/>
                    </Image.RenderTransform>
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, RelativeSource={RelativeSource AncestorType=Grid}}" Value="Visible">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="Anim1">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="0" To="-1920" Duration="0:0:10" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Anim1"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <Image Source="/assets/images/seemless_loading_screen.png" 
               Width="1920" Height="1080" Stretch="UniformToFill"
               Canvas.Left="1919" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <TranslateTransform X="0"/>
                    </Image.RenderTransform>
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, RelativeSource={RelativeSource AncestorType=Grid}}" Value="Visible">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="Anim2">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="0" To="-1920" Duration="0:0:10" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Anim2"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <Image gif:ImageBehavior.AnimatedSource="/assets/characters/default_male/animations/walk/gifs/walk_right.gif"
               Height="500" Canvas.Left="300" Canvas.Top="500"/>

                <TextBlock Text="Chargement..." Foreground="White" FontSize="60" FontWeight="Bold"
                   Canvas.Left="750" Canvas.Top="450">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="20"/>
                    </TextBlock.Effect>
                </TextBlock>

            </Canvas>
        </Grid>
    </Grid>
</Window>