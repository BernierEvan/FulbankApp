<UserControl x:Class="FulbankApp.View.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="clr-namespace:FulbankApp.CustomControls" xmlns:vm="clr-namespace:FulbankApp.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920">

    <!-- ✅ AJOUTE CE DATACONTEXT -->
    <UserControl.DataContext>
        <vm:LoginViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Viewbox Stretch="UniformToFill">
            <Canvas x:Name="MainCanvas" Width="1920" Height="1080"
                RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="CanvasTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!--#region Background-->
                <Image Source="/assets/images/fulbank_login_page.png"
                   Width="1920" Height="1080"
                   Stretch="Fill"/>
                <!--#endregion-->

                <!--#region DarkOverlay-->
                <Rectangle x:Name="DarkOverlay"
                       Fill="#AA000000"
                       Width="1920" Height="1080"
                       Opacity="0"/>
                <!--#endregion-->

                <!--#region Halos-->
                <Ellipse x:Name="Halo"
                     Width="372" Height="348"
                     Canvas.Left="774" Canvas.Top="586"
                     Fill="#CFFF04"
                     Opacity="0.3"
                     Visibility="{Binding IsHaloVisible, Converter={StaticResource BoolToVis}}"
                     RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="Halo2"
                     Width="173" Height="162"
                     Canvas.Left="1451" Canvas.Top="656"
                     Fill="#CFFF04"
                     Opacity="0.3"
                     Visibility="{Binding IsHaloVisible, Converter={StaticResource BoolToVis}}"
                     RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <!--#endregion-->

                <!--#region Personnage Cliquable-->
                <Button x:Name="CharacterButton"
                    Canvas.Left="200" Canvas.Top="625"
                    Width="300" Height="400"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    Click="CharacterButton_Click"
                    Visibility="{Binding AreButtonsVisible, Converter={StaticResource BoolToVis}}"
                    RenderTransformOrigin="0.5,0.5">

                    <Grid x:Name="CharacterContentGrid"
                      Width="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Width}"
                      Height="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Height}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">

                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CharacterScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="CharacterTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Ellipse x:Name="CharacterGlow"
                             Fill="#33CFFF04"
                             Opacity="0"
                             IsHitTestVisible="False"/>

                        <Viewbox Stretch="Uniform">
                            <Image x:Name="CharacterImage"
                               Source="/assets/characters/default_male/idle/idle_down.png"
                               RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform x:Name="CharacterImageLocalScale" ScaleX="2" ScaleY="2"/>
                                </Image.RenderTransform>
                            </Image>
                        </Viewbox>
                    </Grid>
                </Button>
                <!--#endregion-->

                <!--#region Formulaire de Connexion-->
                <Border Canvas.Left="700" Canvas.Top="400"
                    Width="520" Height="400"
                    Background="#DD1A1A2E"
                    BorderBrush="#AACFFF04"
                    BorderThickness="2"
                    CornerRadius="15"
                    Visibility="{Binding IsLoginFormVisible, Converter={StaticResource BoolToVis}}">

                    <StackPanel Margin="40,30">
                        <TextBlock Text="Connexion"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>

                        <!-- Username -->
                        <TextBlock Text="Nom d'utilisateur"
                               Foreground="White"
                               FontSize="16"
                               Margin="0,0,0,5"/>
                        <TextBox x:Name="UsernameInput"
                             Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             FontSize="16"
                             Padding="10"
                             Margin="0,0,0,20"/>

                        <!-- Password -->
                        <TextBlock Text="Mot de passe"
                               Foreground="White"
                               FontSize="16"
                               Margin="0,0,0,5"/>
                        <cc:BindingPasswordBox 
                            Password="{Binding LoginPassword, Mode=TwoWay}"
                            Height="40"
                            Margin="0,0,0,20"/>

                        <!-- Bouton Login -->
                        <Button Content="Se connecter"
                            Command="{Binding LoginCommand}"
                            Height="45"
                            FontSize="18"
                            FontWeight="Bold"
                            Margin="0,10,0,15"
                            Style="{StaticResource HoverButton}"/>

                        <!-- Lien Register -->
                        <TextBlock HorizontalAlignment="Center">
                            <Hyperlink Command="{Binding ShowRegisterFormCommand}"
                                   Foreground="#00FFFF">
                                <Run Text="Créer un compte"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!--#endregion-->

                <!--#region Formulaire d'Inscription-->
                <Border Canvas.Left="700" Canvas.Top="250"
                    Width="520" Height="580"
                    Background="#DD1A1A2E"
                    BorderBrush="#AACFFF04"
                    BorderThickness="2"
                    CornerRadius="15"
                    Visibility="{Binding IsRegisterFormVisible, Converter={StaticResource BoolToVis}}">

                    <StackPanel Margin="40,30">
                        <TextBlock Text="Créer un compte"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                        <!-- Nom -->
                        <TextBlock Text="Nom"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,0,0,5"/>
                        <TextBox Text="{Binding RegisterName, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             FontSize="14"
                             Padding="8"
                             Margin="0,0,0,12"/>

                        <!-- Prénom -->
                        <TextBlock Text="Prénom"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,0,0,5"/>
                        <TextBox Text="{Binding RegisterLastName, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             FontSize="14"
                             Padding="8"
                             Margin="0,0,0,12"/>

                        <!-- Email -->
                        <TextBlock Text="Email"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,0,0,5"/>
                        <TextBox Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             FontSize="14"
                             Padding="8"
                             Margin="0,0,0,12"/>

                        <!-- Mot de passe -->
                        <TextBlock Text="Mot de passe (min. 8 caractères)"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,0,0,5"/>
                        <cc:BindingPasswordBox 
                            Password="{Binding RegisterPassword, Mode=TwoWay}"
                            Height="35"
                            Margin="0,0,0,12"/>

                        <!-- Confirmation -->
                        <TextBlock Text="Confirmer le mot de passe"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,0,0,5"/>
                        <cc:BindingPasswordBox 
                            Password="{Binding RegisterPasswordConfirm, Mode=TwoWay}"
                            Height="35"
                            Margin="0,0,0,15"/>

                        <!-- Bouton Register -->
                        <Button Content="Créer le compte"
                            Command="{Binding RegisterCommand}"
                            Height="40"
                            FontSize="16"
                            FontWeight="Bold"
                            Margin="0,5,0,10"
                            Style="{StaticResource HoverButton}"/>

                        <!-- Lien retour Login -->
                        <TextBlock HorizontalAlignment="Center">
                            <Hyperlink Command="{Binding ShowLoginFormCommand}"
                                   Foreground="#00FFFF">
                                <Run Text="Déjà un compte ? Se connecter"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!--#endregion-->

                <!--#region Messages d'erreur/succès-->
                <Border Canvas.Left="710" Canvas.Top="850"
                    Width="500"
                    Background="#DDFF3333"
                    BorderBrush="Red"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15,10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="White"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                </Border>

                <Border Canvas.Left="710" Canvas.Top="850"
                    Width="500"
                    Background="#DD33FF33"
                    BorderBrush="Green"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15,10"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                </Border>
                <!--#endregion-->

                <!--#region Boutons Login/Register (sur les halos)-->
                <Button x:Name="LoginButton"
                    Style="{StaticResource HoverButton}"
                    Content="Login"
                    Width="240" Height="80"
                    Canvas.Left="840" 
                    Canvas.Top="712"
                    FontSize="24"
                    Command="{Binding ShowLoginFormCommand}"
                    Visibility="{Binding AreButtonsVisible, Converter={StaticResource BoolToVis}}"
                    Opacity="0">
                    <Button.Effect>
                        <DropShadowEffect Color="#00FFFF" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
                    </Button.Effect>
                </Button>

                <Button x:Name="RegisterButton"
                    Style="{StaticResource HoverButton}"
                    Content="Register"
                    Width="153" Height="43"
                    Canvas.Left="1461" 
                    Canvas.Top="716"
                    FontSize="18"
                    Command="{Binding ShowRegisterFormCommand}"
                    Visibility="{Binding AreButtonsVisible, Converter={StaticResource BoolToVis}}"
                    Opacity="0">
                    <Button.Effect>
                        <DropShadowEffect Color="#00FFFF" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
                    </Button.Effect>
                </Button>
                <!--#endregion-->

                <!--#region Clavier PIN-->
                <StackPanel Canvas.Left="810" Canvas.Top="450"
                        Visibility="{Binding IsPinPadVisible, Converter={StaticResource BoolToVis}}">

                    <!-- Instructions -->
                    <TextBlock Text="{Binding PinInstructions}"
                           FontSize="20"
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,0,0,20"
                           TextWrapping="Wrap"
                           Width="300"/>

                    <!-- Affichage PIN -->
                    <Border Background="#DD1A1A2E"
                        BorderBrush="#CFFF04"
                        BorderThickness="2"
                        CornerRadius="10"
                        Padding="20,15"
                        Margin="0,0,0,30"
                        Width="300">
                        <TextBlock Text="{Binding PinDisplay}"
                               FontSize="32"
                               Foreground="White"
                               TextAlignment="Center"
                               FontFamily="Consolas"
                               TextOptions.TextFormattingMode="Display"/>
                    </Border>

                    <!-- Grille de boutons PIN -->
                    <Grid Width="280" Height="280">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Button Content="1" Grid.Row="0" Grid.Column="0" 
                            Style="{StaticResource RoundPinButton}"
                            Command="{Binding PinButtonCommand}" CommandParameter="1"/>
                        <Button Content="2" Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource RoundPinButton}"
                            Command="{Binding PinButtonCommand}" CommandParameter="2"/>
                        <Button Content="3" Grid.Row="0" Grid.Column="2"
                            Style="{StaticResource RoundPinButton}"
                            Command="{Binding PinButtonCommand}" CommandParameter="3"/>

                        <Button Content="4" Grid.Row="1" Grid.Column="0"
                            Style="{StaticResource RoundPinButton}"
                            Command="{Binding PinButtonCommand}" CommandParameter="4"/>
                        <Button Content="5" Grid.Row="1" Grid.Column="1"
                            Style="{StaticResource RoundPinButton}"
                            Command="{Binding PinButtonCommand}" CommandParameter="5"/>
                        <Button Content="6" Grid.Row="1" Grid.Column="2"
                            Style="{StaticResource RoundPinButton}"
                            Command="{Binding PinButtonCommand}" CommandParameter="6"/>

                        <Button Content="7" Grid.Row="2" Grid.Column="0"
                            Style="{StaticResource RoundPinButton}"
                            Command="{Binding PinButtonCommand}" CommandParameter="7"/>
                        <Button Content="8" Grid.Row="2" Grid.Column="1"
                            Style="{StaticResource RoundPinButton}"
                            Command="{Binding PinButtonCommand}" CommandParameter="8"/>
                        <Button Content="9" Grid.Row="2" Grid.Column="2"
                            Style="{StaticResource RoundPinButton}"
                            Command="{Binding PinButtonCommand}" CommandParameter="9"/>

                        <Button Content="←" Grid.Row="3" Grid.Column="0"
                            Style="{StaticResource RoundPinBackButton}"
                            Command="{Binding PinButtonCommand}" CommandParameter="←"/>
                        <Button Content="0" Grid.Row="3" Grid.Column="1"
                            Style="{StaticResource RoundPinButton}"
                            Command="{Binding PinButtonCommand}" CommandParameter="0"/>
                        <Button Content="X" Grid.Row="3" Grid.Column="2"
                            Style="{StaticResource RoundPinValidButton}"
                            Command="{Binding PinButtonCommand}" CommandParameter="X"/>
                    </Grid>

                    <!-- Bouton retour -->
                    <Button Content="← Retour"
                        Command="{Binding BackCommand}"
                        Width="150"
                        Height="40"
                        Margin="0,30,0,0"
                        Style="{StaticResource HoverButton}"/>
                </StackPanel>
                <!--#endregion-->

                <!--#region Skin Selection Panel-->
                <Border x:Name="SkinSelectionPanel"
                    Canvas.Left="600" Canvas.Top="300"
                    Width="700" Height="500"
                    Background="#DD000000"
                    BorderBrush="#AACFFF04"
                    BorderThickness="3"
                    CornerRadius="20"
                    Visibility="Collapsed"
                    Opacity="0">
                    <Border.Effect>
                        <DropShadowEffect Color="#CFFF04" BlurRadius="40" ShadowDepth="0" Opacity="0.7"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="80"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="80"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                               Text="Choose Your Character"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <WrapPanel Grid.Row="1"
                               x:Name="SkinContainer"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Orientation="Horizontal"
                               Width="650"/>

                        <Button Grid.Row="2"
                            Content="Close"
                            Style="{StaticResource HoverButton}"
                            Width="150" Height="50"
                            HorizontalAlignment="Center"
                            Click="CloseSkinPanel_Click"/>
                    </Grid>
                </Border>
                <!--#endregion-->

            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>