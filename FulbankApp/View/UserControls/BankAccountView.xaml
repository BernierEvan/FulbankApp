<UserControl x:Class="FulbankApp.View.BankAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FulbankApp.View"
             xmlns:vm="clr-namespace:FulbankApp.ViewModels"
             xmlns:v="clr-namespace:FulbankApp.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">


    <DockPanel>

        <!-- HEADER -->
        <Border DockPanel.Dock="Top" Background="#1A4A8F" Height="70">
            <Grid>
                <TextBlock Text="Mon compte bancaire"
                           Foreground="White" FontSize="24" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Evan" Foreground="White" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Ellipse Width="36" Height="36" Fill="White" Opacity="0.9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <TextBlock DockPanel.Dock="Bottom" Text="Connexion sécurisée · SSL activé"
                   FontSize="12" HorizontalAlignment="Center"
                   Foreground="Gray" Margin="0,6"/>

        <!-- CONTENT -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="18">
            <StackPanel Orientation="Vertical" Margin="0,0,0,20">

                <!-- Carte compte courant -->
                <Border Background="#E6EEF8" CornerRadius="15" Padding="22"
                        Margin="0,0,0,16" BorderBrush="#C2D4EA" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">

                        <!-- Infos compte -->
                        <StackPanel Width="450">
                            <TextBlock Text="Compte courant" Foreground="#1A4A8F"
                                       FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Evan Dupont" Margin="0,10,0,0"
                                       FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="IBAN : FR76 1234 5678 9012 3456 7890 123"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Type : Compte individuel" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Solde -->
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Solde disponible" FontSize="16"
                                       Foreground="#1A4A8F"/>
                            <TextBlock Text="2 350,00 €" FontSize="34"
                                       FontWeight="Bold" Foreground="#1A4A8F"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Section Transactions -->
                <TextBlock Text="Historique des transactions"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#1A4A8F" Margin="0,0,0,12"/>

                <!-- Barre recherche -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Width="280" Height="32"
                             Margin="0,0,10,0"/>
                    <Button Content="Rechercher" Width="120" Height="32"
                            Background="#1A4A8F" Foreground="White"
                            BorderThickness="0" />
                </StackPanel>

                <!-- Liste des transactions -->
                <StackPanel>
                    <!-- Transaction exemple -->
                    <Border Background="White" CornerRadius="10"
                            Padding="12" Margin="0,0,0,8"
                            BorderBrush="#D9DFE7" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="180">
                                <TextBlock Text="Virement reçu" FontWeight="SemiBold"/>
                                <TextBlock Text="DE: Marie Dupont" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Width="150">
                                <TextBlock Text="+ 500,00 €" FontWeight="Bold"/>
                                <TextBlock Text="24/11/2025" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="Terminé" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="#1A4A8F"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Transaction 2 -->
                    <Border Background="White" CornerRadius="10"
                            Padding="12" Margin="0,0,0,8"
                            BorderBrush="#D9DFE7" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="180">
                                <TextBlock Text="Paiement carte" FontWeight="SemiBold"/>
                                <TextBlock Text="Amazon FR" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Width="150">
                                <TextBlock Text="- 120,00 €" FontWeight="Bold"/>
                                <TextBlock Text="22/11/2025" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="Terminé" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="#1A4A8F"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
