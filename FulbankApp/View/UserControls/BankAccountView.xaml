<UserControl x:Class="FulbankApp.View.BankAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FulbankApp.View"
             xmlns:vm="clr-namespace:FulbankApp.ViewModels"
             xmlns:v="clr-namespace:FulbankApp.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">



    <DockPanel>


        <!-- HEADER -->
        <Border DockPanel.Dock="Top" Background="#1A4A8F" Height="70">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="401*"/>
                    <ColumnDefinition Width="399*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Home" Click="NavigateButton_Click" Command="{Binding NavigateCommand}" CommandParameter="Home" Style="{StaticResource NavButtonStyle}"  Tag="Home" FontSize="20" Margin="287,20,40,17" Height="NaN" RenderTransformOrigin="0.071,0.551"/>

                <TextBlock Text="Mon compte bancaire"
                           Foreground="White" FontSize="24" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="20,0,114,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="300,0,0,0" Grid.Column="1">
                    <TextBlock Text="Evan" Foreground="White" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Ellipse Width="36" Height="36" Fill="White" Opacity="0.9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <TextBlock DockPanel.Dock="Bottom" Text="Connexion sécurisée · SSL activé"
                   FontSize="12" HorizontalAlignment="Center"
                   Foreground="Gray" Margin="0,6"/>

        <!-- CONTENT -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="18">
            <StackPanel Orientation="Vertical" Margin="0,0,0,20">

                <!-- Carte compte courant -->
                <Border Background="#E6EEF8" CornerRadius="15" Padding="22"
                        Margin="0,0,0,16" BorderBrush="#C2D4EA" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">

                        <!-- Infos compte -->
                        <StackPanel Width="450">
                            <TextBlock Text="Compte courant" Foreground="#1A4A8F"
                                       FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Evan Dupont" Margin="0,10,0,0"
                                       FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedAccount.IdAccount, StringFormat='IBAN : {0}'}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Type : Compte individuel" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Solde -->
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Solde disponible" FontSize="16"
                                       Foreground="#1A4A8F"/>

                            <TextBlock>
                                <Run Text="{Binding SelectedAccount.Balance, TargetNullValue='Non renseigné', FallbackValue='Chargement...', StringFormat=N2}" 
                                     FontWeight="Bold" 
                                     Foreground="Black" 
                                     FontSize="34" />

                                <Run Text=" " FontSize="34"/>

                                <Run Text="{Binding SelectedAccount.IdFiat}" 
                                     FontSize="34" 
                                     FontWeight="Bold" 
                                     Foreground="#1A4A8F"/>
                            </TextBlock>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Section Transactions -->
                <TextBlock Text="Historique des opérations"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#1A4A8F" Margin="0,0,0,12"/>

                <!-- Barre recherche -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Width="280" Height="32"
                             Margin="0,0,10,0"/>
                    <Button Content="Rechercher" Width="120" Height="32"
                            Background="#1A4A8F" Foreground="White"
                            BorderThickness="0" />
                </StackPanel>

                <!-- Liste des transactions -->
                <StackPanel>
                    
                    <!-- Transaction exemple -->
                    <Border Background="White" CornerRadius="10"
                            Padding="12" Margin="0,0,0,8"
                            BorderBrush="#D9DFE7" BorderThickness="1">

                        <DataGrid x:Name="BeneficiariesGrid" 
                                ItemsSource="{Binding Operations}" 
                                AutoGenerateColumns="True" 
                                Margin="10" />

                    </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
