                                        Height="50"
                                        Style="{StaticResource UserAccountComboBoxStyle}"
                                        ItemsSource="{Binding AccountOptions}"
                                        SelectedItem="{Binding SelectedOption}"
                                        DisplayMemberPath="DisplayName"
                                        VerticalAlignment="Center"/>

