                <Button x:Name="CryptoButton"
                    Style="{StaticResource HoverButton}"
                    Tag="Wallet"
                    Content="Crypto Wallet"
                    Width="240" Height="80"
                    Canvas.Left="1480" 
                    Canvas.Top="450"
                    MouseEnter="Button_MouseEnter"
                    MouseLeave="Button_MouseLeave"
                    Click="GameButton_Click"
                    FontSize="24"
                    Cursor="Hand"
                    Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button.RenderTransform>
                        <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                    </Button.RenderTransform>
                    <Button.RenderTransformOrigin>0.5,0.5</Button.RenderTransformOrigin>
                    <Button.Effect>
                        <DropShadowEffect Color="#00FFFF" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
                    </Button.Effect>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!-- Zoom in -->
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                         To="1.2" Duration="0:0:0.1" />
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                         To="1.2" Duration="0:0:0.1" />
                                    <!-- Zoom out -->
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                         To="0.9" Duration="0:0:0.1" BeginTime="0:0:0.1" />
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                         To="0.9" Duration="0:0:0.1" BeginTime="0:0:0.1" />

                                    <!-- Shrink -->
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                         To="0" Duration="0:0:0.15" BeginTime="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                         To="0" Duration="0:0:0.15" BeginTime="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <!-- Survol du bouton -->
                        <EventTrigger RoutedEvent="Button.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius"
                                                 From="20" To="50"
                                                 Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Halo"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="CryptoButton"
