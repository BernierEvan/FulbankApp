<Application x:Class="FulbankApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FulbankApp.Converters"
             StartupUri="View/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Templates.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/UserControlStyles/BankAccountStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/UserControlStyles/BeneficiariesStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/UserControlStyles/ConvertStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/UserControlStyles/HomeStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/UserControlStyles/LoginStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/UserControlStyles/MainStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/UserControlStyles/SettingsStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/UserControlStyles/TransferStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/UserControlStyles/WalletStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/GlobalStyles/ColorsStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/GlobalStyles/ButtonsStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/GlobalStyles/FontsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>